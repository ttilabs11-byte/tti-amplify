{
  "name": "TTI Amplify",
  "short_name": "Amplify",
  "description": "Open, engage and confirm every Tti LinkedIn post.",
  "id": "./",
  "start_url": "./#/home",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#0B1630",
  "theme_color": "#12224A",
  "categories": ["business", "productivity", "social"],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "./",
    "method": "GET",
    "params": { "title": "title", "text": "text", "url": "url" }
  },
  "shortcuts": [
    { "name": "To do", "url": "./#/home", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Add a post", "url": "./#/admin/new", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
